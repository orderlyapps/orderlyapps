{
  "name": "@amodeo/proclaimer",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./database/*": {
      "development": "./src/database/*.ts",
      "types": "./dist/database/*.d.mts",
      "import": "./dist/database/*.mjs"
    },
    "./feature/*": {
      "development": "./src/feature/*/index.ts",
      "types": "./dist/feature/*/index.d.mts",
      "import": "./dist/feature/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "download:schema": "supabase db dump --schema public -f supabase/public_schema.sql",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@amodeo/ionic": "workspace:*",
    "@amodeo/utils": "workspace:*",
    "@ionic/react": "catalog:",
    "@ionic/react-router": "catalog:",
    "@mapbox/mapbox-gl-draw": "catalog:",
    "@react-pdf/renderer": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/browser-db-sqlite-persistence": "catalog:",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/rxdb-db-collection": "catalog:",
    "date-fns": "catalog:",
    "ionicons": "catalog:",
    "react": "catalog:",
    "rxdb": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amodeo/config": "workspace:*",
    "@tanstack/react-query-devtools": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bumpp": "^11.1.0",
    "happy-dom": "catalog:",
    "react-dom": "catalog:",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
