{
  "name": "@amodeo/proclaimer",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist",
    "src/ui/css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types@development": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./database/*": {
      "development": "./src/database/*.ts",
      "types": "./dist/database/*.d.mts",
      "import": "./dist/database/*.mjs"
    },
    "./feature/*": {
      "development": "./src/feature/*/index.ts",
      "types": "./dist/feature/*/index.d.mts",
      "import": "./dist/feature/*/index.mjs"
    },
    "./ui/components/*": {
      "development": "./src/ui/components/*.tsx",
      "types": "./dist/ui/components/*.d.mts",
      "import": "./dist/ui/components/*.mjs"
    },
    "./ui/components/inputs/address/types": {
      "development": "./src/ui/components/inputs/address/types.ts",
      "types": "./dist/ui/components/inputs/address/types.d.mts",
      "import": "./dist/ui/components/inputs/address/types.mjs"
    },
    "./ui/vendor/mapbox/MapView": {
      "development": "./src/ui/vendor/mapbox/MapView.tsx",
      "types": "./dist/ui/vendor/mapbox/MapView.d.mts",
      "import": "./dist/ui/vendor/mapbox/MapView.mjs"
    },
    "./ui/vendor/mapbox/MapStyleSelect": {
      "development": "./src/ui/vendor/mapbox/MapStyleSelect.tsx",
      "types": "./dist/ui/vendor/mapbox/MapStyleSelect.d.mts",
      "import": "./dist/ui/vendor/mapbox/MapStyleSelect.mjs"
    },
    "./ui/vendor/mapbox/*": {
      "development": "./src/ui/vendor/mapbox/*.ts",
      "types": "./dist/ui/vendor/mapbox/*.d.mts",
      "import": "./dist/ui/vendor/mapbox/*.mjs"
    },
    "./ui/colors/jwColors": {
      "development": "./src/ui/colors/jwColors.ts",
      "types": "./dist/ui/colors/jwColors.d.mts",
      "import": "./dist/ui/colors/jwColors.mjs"
    },
    "./util/font-size": {
      "development": "./src/util/font-size/index.ts",
      "types": "./dist/util/font-size/index.d.mts",
      "import": "./dist/util/font-size/index.mjs"
    },
    "./util/hooks/use-accordion-state": {
      "development": "./src/util/hooks/use-accordion-state/index.ts",
      "types": "./dist/util/hooks/use-accordion-state/index.d.mts",
      "import": "./dist/util/hooks/use-accordion-state/index.mjs"
    },
    "./util/hooks/use-breakpoint": {
      "development": "./src/util/hooks/use-breakpoint/index.ts",
      "types": "./dist/util/hooks/use-breakpoint/index.d.mts",
      "import": "./dist/util/hooks/use-breakpoint/index.mjs"
    },
    "./util/hooks/use-orientation": {
      "development": "./src/util/hooks/use-orientation/index.ts",
      "types": "./dist/util/hooks/use-orientation/index.d.mts",
      "import": "./dist/util/hooks/use-orientation/index.mjs"
    },
    "./util/theme": {
      "development": "./src/util/theme/index.ts",
      "types": "./dist/util/theme/index.d.mts",
      "import": "./dist/util/theme/index.mjs"
    },
    "./util/*": {
      "development": "./src/util/*.ts",
      "types": "./dist/util/*.d.mts",
      "import": "./dist/util/*.mjs"
    },
    "./ui/css/index.css": "./src/ui/css/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "download:schema": "supabase db dump --schema public -f src/database/supabase/public_schema.sql",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@amodeo/ionic": "workspace:*",
    "@amodeo/proclaimer": "workspace:*",
    "@amodeo/utils": "workspace:*",
    "@ionic/react": "catalog:",
    "@ionic/react-router": "catalog:",
    "@mapbox/mapbox-gl-draw": "catalog:",
    "@maskito/core": "catalog:",
    "@maskito/phone": "catalog:",
    "@maskito/react": "catalog:",
    "@react-pdf/renderer": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/browser-db-sqlite-persistence": "catalog:",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/rxdb-db-collection": "catalog:",
    "date-fns": "catalog:",
    "docx": "catalog:",
    "ionicons": "catalog:",
    "libphonenumber-js": "^1.11.21",
    "mapbox-gl": "catalog:",
    "meeting-schedules-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "catalog:",
    "rxdb": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amodeo/config": "workspace:*",
    "@tanstack/react-query-devtools": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/mapbox__mapbox-gl-draw": "^1.4.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bumpp": "^11.1.0",
    "happy-dom": "catalog:",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
