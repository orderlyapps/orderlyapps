{
  "name": "wiz-bang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 4200 --mode proclaimer --host --open",
    "build": "tsc -b && vp build --mode proclaimer",
    "lint": "vp lint .",
    "preview": "vp preview",
    "deploy": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=wiz-bang && echo DEPLOYED TO WIZ BANG",
    "deploy:beta": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=beta && echo '✓ DEPLOYED TO BETA'",
    "deploy:proclaimer": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=proclaimer && echo '✓ DEPLOYED TO orderly/proclaimer'",
    "deploy:main": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=main && wrangler pages deploy dist --project-name=proclaimer --branch=main && echo '✓✓ DEPLOYED TO orderly/main AND proclaimer/main'",
    "supabase:download:public_schema": "supabase db dump --schema public -f src/apps/shared/database/public_schema.sql",
    "supabase:update": "brew upgrade supabase"
  },
  "dependencies": {
    "@ionic/react": "^8.8.6",
    "@ionic/react-router": "^8.8.6",
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "@maskito/core": "^5.2.2",
    "@maskito/phone": "^5.2.2",
    "@maskito/react": "^5.2.2",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/browser-db-sqlite-persistence": "catalog:",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/rxdb-db-collection": "catalog:",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "ionicons": "^8.0.13",
    "libphonenumber-js": "^1.11.21",
    "mapbox-gl": "^3.23.1",
    "meeting-schedules-parser": "^4.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-zoom-pan-pinch": "^4.0.3",
    "rxdb": "^17.3.0",
    "workbox-window": "^7.3.0",
    "zod": "^4.4.3"
  },
