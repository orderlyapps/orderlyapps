{
  "name": "proclaimer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 4200 --mode proclaimer --host --open",
    "build": "tsc -b && vp build --mode proclaimer",
    "lint": "vp lint",
    "preview": "vp preview",
    "deploy": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=wiz-bang && echo DEPLOYED TO WIZ BANG",
    "deploy:beta": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=beta && echo '✓ DEPLOYED TO BETA'",
    "deploy:preview": "cd ../.. && vp run --filter @amodeo/proclaimer build && cd apps/proclaimer && vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=proclaimer && echo '✓ DEPLOYED TO orderly/proclaimer'",
    "deploy:main": "vp build --mode proclaimer && wrangler pages deploy dist --project-name=orderly --branch=main && wrangler pages deploy dist --project-name=proclaimer --branch=main && echo '✓✓ DEPLOYED TO orderly/main AND proclaimer/main'",
    "supabase:update": "brew upgrade supabase"
  },
  "dependencies": {
    "@amodeo/proclaimer": "workspace:*",
    "@ionic/react": "catalog:",
    "@ionic/react-router": "catalog:",
    "@mapbox/mapbox-gl-draw": "catalog:",
    "@maskito/core": "catalog:",
    "@maskito/phone": "catalog:",
    "@maskito/react": "catalog:",
    "@react-pdf/renderer": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/browser-db-sqlite-persistence": "catalog:",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/rxdb-db-collection": "catalog:",
    "date-fns": "catalog:",
    "docx": "catalog:",
    "ionicons": "catalog:",
    "libphonenumber-js": "^1.11.21",
    "mapbox-gl": "catalog:",
    "qrcode.react": "^4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:",
    "react-zoom-pan-pinch": "catalog:",
    "rxdb": "catalog:",
    "workbox-window": "^7.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amodeo/config": "workspace:*",
    "@types/mapbox__mapbox-gl-draw": "^1.4.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
