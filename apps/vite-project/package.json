{
  "name": "vite-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host --open",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "preview": "vp preview",
    "deploy": "vp build && wrangler pages deploy dist --project-name=orderlyapps --branch=vite-project",
    "generate-assets": "set -a && . ./.env && set +a && vp exec pwa-asset-generator public/assets/images/logo.svg public/assets/images/ --icon-only --type png --background \"$VITE_THEME_COLOR\" --opaque --scrape false"
  },
  "dependencies": {
    "@amodeo/ionic": "workspace:*",
    "@amodeo/proclaimer": "workspace:*",
    "@amodeo/utils": "workspace:*",
    "@ionic/react": "catalog:",
    "@ionic/react-router": "catalog:",
    "ionicons": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@amodeo/config": "workspace:*",
    "@puppeteer/browsers": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-router-dom": "catalog:",
    "@vitejs/plugin-basic-ssl": "catalog:",
    "pwa-asset-generator": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
